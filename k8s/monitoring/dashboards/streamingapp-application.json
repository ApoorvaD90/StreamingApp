        "uid": "prometheus"
      },
      "description": "Backend pods answering GET /metrics (4 services at 1 replica = 4).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{namespace=\"streamingapp\"})",
          "legendFormat": "",
          "refId": "A"
