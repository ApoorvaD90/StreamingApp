// Sprint 3: configuration management (job: streamingapp-ansible)
// Triggered automatically by streamingapp-infra after a successful apply; can also be run manually.
pipeline {
  agent any
  parameters {
    string(name: 'APP_URL', defaultValue: '',
           description: 'Public app URL for CORS, e.g. http://<ALB DNS>. Leave empty to auto-detect from the Ingress.')
  }
  environment {
    AWS_DEFAULT_REGION        = 'us-east-1'
    ANSIBLE_HOST_KEY_CHECKING = 'False'
    ANSIBLE_FORCE_COLOR       = 'true'
  }
  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    timestamps()
  }
  stages {
    stage('Read Terraform outputs') {
      steps {
        dir('terraform') {
          sh 'terraform init -input=false'
          script {
            env.VPC_ID      = sh(script: 'terraform output -raw vpc_id', returnStdout: true).trim()
            env.LB_ROLE_ARN = sh(script: 'terraform output -raw lb_controller_role_arn', returnStdout: true).trim()
            env.S3_BUCKET   = sh(script: 'terraform output -raw s3_bucket_name', returnStdout: true).trim()
          }
        }
        script {
          // Parameters can't be overwritten via env, hence the separate APP_PUBLIC_URL name.
          // Empty on a brand-new cluster (no ALB yet): re-run this job after the first app deploy.
          if (params.APP_URL?.trim()) {
            env.APP_PUBLIC_URL = params.APP_URL.trim()
          } else {
            def albHost = sh(returnStdout: true, script: '''
              aws eks update-kubeconfig --name streamingapp-cluster --region $AWS_DEFAULT_REGION > /dev/null
              kubectl get ingress streamingapp-ingress-frontend -n streamingapp \
                -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true
            ''').trim()
            env.APP_PUBLIC_URL = albHost ? "http://${albHost}" : ''
          }
          echo "APP_PUBLIC_URL = '${env.APP_PUBLIC_URL}'"
        }
      }
    }
    stage('Configure EC2 instances') {
      steps {
        dir('ansible') {
          withCredentials([sshUserPrivateKey(credentialsId: 'streamingapp-ssh-key', keyFileVariable: 'SSH_KEY')]) {
            // jenkins role skipped: Jenkins must never reinstall/restart itself from inside its own job
            sh 'ansible-playbook -i inventory-jenkins/aws_ec2.yml site.yml --private-key "$SSH_KEY" --skip-tags jenkins'
          }
        }
      }
    }
    stage('Configure EKS cluster') {
      steps {
        dir('ansible') {
          withCredentials([string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET')]) {
            sh 'ansible-playbook -i localhost, k8s-bootstrap.yml'
          }
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}
